# Copy this file to .env and fill it in. .env is git-ignored, so the password stays off GitHub.

# The OneDrive folder Power Automate saves into, as synced onto this laptop.
LANDING_DIR=C:\Users\you\OneDrive - YourOrg\FinancialReports

AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USER=loader
AZURE_SQL_PASSWORD=change-me

# Optional. This is the default.
ODBC_DRIVER=ODBC Driver 18 for SQL Server
